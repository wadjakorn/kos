*.pyc
.DS_Store
.vscode/

# Local extractor config (may hold endpoints/model choices) + LLM extraction cache
config/extractor.json
.cache/

# Machine-local data-root pointer (path differs per machine). Commit the
# .example variant only. See config/paths.example.json.
config/paths.json

# Knowledge data ("the db") lives in a SEPARATE repo — the sibling ../db dir
# (knowledge-base/{kos,db}), with its own git history. It is not part of this
# repo at all, so there are no data-dir ignore rules here. The db repo carries
# its own .gitignore (.cache/, logs/*.log).
