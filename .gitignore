__pycache__/
*.pyc
.DS_Store
.vscode/

# Local extractor config (may hold endpoints/model choices) + LLM extraction cache
config/extractor.json
.cache/

# Machine-local data-root pointer (path differs per machine). Commit the
# .example variant only. See config/paths.example.json.
config/paths.json

# Ingest run logs are local artifacts; keep the dir, not the runs.
logs/*.log

# Knowledge data ("the db") — local-only, not version-controlled.
# Keep the directory skeleton (.gitkeep), ignore everything else.
atoms/*
!atoms/.gitkeep
sources/*
!sources/.gitkeep
theses/*
!theses/.gitkeep
projects/*
!projects/.gitkeep
indexes/*
!indexes/.gitkeep
